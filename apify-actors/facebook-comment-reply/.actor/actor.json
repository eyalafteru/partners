{
  "actorSpecification": 1,
  "name": "facebook-comment-reply",
  "title": "Facebook Comment Reply",
  "description": "Reply to comments on Facebook posts using Playwright automation",
  "version": "1.0.0",
  "input": {
    "type": "object",
    "schemaVersion": 1,
    "properties": {
      "postUrl": {
        "title": "Post URL",
        "type": "string",
        "description": "URL of the Facebook post",
        "editor": "textfield"
      },
      "commentId": {
        "title": "Comment ID",
        "type": "string",
        "description": "ID of the comment to reply to",
        "editor": "textfield"
      },
      "replyMessage": {
        "title": "Reply Message",
        "type": "string",
        "description": "The message to reply with",
        "editor": "textarea"
      },
      "cookies": {
        "title": "Facebook Cookies",
        "type": "array",
        "description": "Facebook session cookies for authentication",
        "editor": "json"
      },
      "proxyConfiguration": {
        "title": "Proxy Configuration",
        "type": "object",
        "description": "Optional proxy settings",
        "editor": "json"
      }
    },
    "required": ["postUrl", "replyMessage", "cookies"]
  },
  "output": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "commentId": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  }
}
